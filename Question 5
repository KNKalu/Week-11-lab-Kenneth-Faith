mutate(

      station = as.character(start_station),
      time = start_time,
      inventory_change = -1,
      event_type = "C"
    ) %>%
    select(station, time, inventory_change, event_type)


  destination <- sample_bike %>%
    mutate(

      station = as.character(end_station),
      time = end_time,
      inventory_change = 1,
      event_type = "R"
    ) %>%
    select(station, time, inventory_change, event_type)


  trip_times <- bind_rows(origin, destination) %>%
    filter(time >= window_start, time < window_end) %>%
    arrange(station, time, desc(inventory_change))


  inventory_per_station <- trip_times %>%
    group_by(station) %>%
    mutate(
      cumulative_change = cumsum(inventory_change),
      initial_inventory = max(0, -min(cumulative_change)),
      inventory = initial_inventory + cumulative_change
    ) %>%
    ungroup()

  hours <- seq(window_start, window_end, by = "hour")


  stations <- unique(c(
    as.character(sample_bike$start_station),
    as.character(sample_bike$end_station)
  ))

  station_boundaries <- data.frame(
    station = rep(stations, each = length(hours)),
    time = rep(hours, times = length(stations)),
    inventory_change = 0
  )


  inventory_timeline <- bind_rows(
    inventory_per_station %>%
      select(station, time, inventory_change),
    station_boundaries

  ) %>%
    arrange(station, time, desc(inventory_change)) %>%
    group_by(station) %>%
    mutate(
      cumulative_change = cumsum(inventory_change),
      initial_inventory = max(0, -min(cumulative_change)),
      inventory = initial_inventory + cumulative_change,
      next_time = lead(time)
    ) %>%
    filter(!is.na(next_time)) %>%
    mutate(
      duration = as.numeric(difftime(
        next_time, time, units = "hours"
      )),
      available_time = if_else(inventory > 0, duration, 0),
      hour = hour(time)
    ) %>%
    ungroup()


  availability_table <- inventory_timeline %>%
    group_by(station, hour) %>%
    summarise(
      availability = sum(available_time) / days,
      .groups = "drop"
    ) %>%
    rename(origin = station)


  observed_trips <- sample_bike %>%
    filter(
      start_time >= window_start,
      start_time < window_end
    ) %>%
    mutate(
      origin = as.character(start_station),
      destination = as.character(end_station),
      hour = hour(start_time)
    ) %>%
    count(origin, destination, hour, name = "trips")


  station_pairs <- sample_bike %>%
    filter(
      start_time >= window_start,
      start_time < window_end
    ) %>%
    transmute(
      origin = as.character(start_station),
      destination = as.character(end_station)
    ) %>%
    distinct()

  station_hours <- station_pairs %>%
    slice(rep(seq_len(n()), each = 24)) %>%
    mutate(hour = rep(0:23, times = nrow(station_pairs)))

  results <- station_hours %>%

    left_join(
      observed_trips,
      by = c("origin", "destination", "hour")
    ) %>%
    left_join(
      availability_table,
      by = c("origin", "hour")
    ) %>%
    mutate(
      trips = replace_na(trips, 0L),
      observed_rate = trips / days,
      rate = if_else(
        !is.na(availability) & availability > 0,
        observed_rate / availability,
        NA_real_
      )
    ) %>%
    select(
      origin, destination, hour,
      observed_rate, availability, rate
    ) %>%
    arrange(origin, destination, hour)

  return(results)
}
